# SPHOORTHY EVENTS — Environment Configuration Example

# Flask Backend Config
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=
TICKET_SECRET_KEY=
SEED_DEMO_DATA=false

# Supabase PostgreSQL Database
USE_SQLITE=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sphoorthy_events
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cashfree Payment Gateway
CASHFREE_APP_ID=TEST_your_app_id
CASHFREE_SECRET_KEY=cfsk_ma_test_your_secret
CASHFREE_ENV=TEST
CASHFREE_API_VERSION=2023-08-01

# PhonePe Payment Gateway
PHONEPE_MERCHANT_ID=M23V8K26Y6LJR_xxxx
PHONEPE_SALT_KEY=your_salt_key
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT

# Google Workspace / Gmail SMTP Email Setup
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=events@sphoorthy.ac.in
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=events@sphoorthy.ac.in
SMTP_FROM_NAME=Sphoorthy Events Desk
EMAIL_OUTBOX_WORKER_SECRET=

# App Public URL
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Vercel production backend values (set in the backend service environment):
# APP_URL=https://freshers.rudvay.tech
# ALLOWED_ORIGINS=https://freshers.rudvay.tech,https://freshers-nine.vercel.app

# Frontend values are set in the Vercel frontend service environment.
NEXT_PUBLIC_API_URL=/api/v1
